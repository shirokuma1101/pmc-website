# Production template. Copy to .env only on the deployment host.
# Never commit the completed .env file.

# Bind to a specific private/LAN address when the reverse proxy is on another host.
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
DIRECTUS_BIND_IP=127.0.0.1
DIRECTUS_PORT=8055

# Public HTTPS URLs. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL=https://pmc.example.com
NEXT_PUBLIC_DIRECTUS_URL=https://cms.pmc.example.com

# Directus and PostgreSQL secrets. Generate unique random values on the host.
DIRECTUS_SECRET=replace-with-at-least-48-random-characters
DIRECTUS_DB_PASSWORD=replace-with-a-unique-random-database-password
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-unique-random-admin-password

# Production must use HTTPS.
AUTH_COOKIE_SECURE=true

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
AUTH_RATE_LIMIT_TRUST_PROXY=false

# Enable public self-registration only after abuse controls and monitoring are ready.
REGISTRATION_ENABLED=false

# Directus-wide fallback limits. Frontend authentication has stricter limits.
DIRECTUS_RATE_LIMITER_POINTS=100
DIRECTUS_RATE_LIMITER_DURATION=60
DIRECTUS_REGISTRATION_RATE_LIMIT_POINTS=5
DIRECTUS_REGISTRATION_RATE_LIMIT_DURATION=3600

# SMTP is used for password reset messages.
DIRECTUS_EMAIL_FROM=no-reply@pmc.example.com
DIRECTUS_EMAIL_SMTP_HOST=smtp.example.com
DIRECTUS_EMAIL_SMTP_PORT=587
DIRECTUS_EMAIL_SMTP_USER=
DIRECTUS_EMAIL_SMTP_PASSWORD=
DIRECTUS_EMAIL_SMTP_SECURE=false
DIRECTUS_EMAIL_SMTP_IGNORE_TLS=false

# Optional Directus-only secret. Leave empty to disable Discord notifications.
DISCORD_ARTICLE_WEBHOOK_URL=

# Optional public GA4 measurement ID. Leave empty to disable Google Analytics.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Frontend image validation limits. Keep these aligned with Directus.
MAX_IMAGE_UPLOAD_BYTES=8388608
MAX_IMAGE_INPUT_PIXELS=40000000
