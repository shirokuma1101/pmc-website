# dependencies and build output
/node_modules
/.next
/out
/coverage
*.tsbuildinfo
next-env.d.ts
FRONTEND_REQUIREMENTS_DRAFT.md

# local configuration and secrets
.env
.env.*
!.env.example
!.env.*.example
.npmrc
*.pem
*.key
*.p12
*.pfx

# Directus local runtime data (the schema and extension source stay tracked)
/directus/database
/directus/uploads
/directus/extensions/**/node_modules
/.local-backups
/.tmp
/backups
/.production-update.lock

# Dynmap generates large input, output, and working trees here. Keep only the mount points.
/minecraft-map/input/*
!/minecraft-map/input/.gitkeep
/minecraft-map/output/*
!/minecraft-map/output/.gitkeep
/minecraft-map/work/*
!/minecraft-map/work/.gitkeep
/minecraft-map/.env.map

# logs, editors, and local tooling
*.log
.DS_Store
Thumbs.db
.idea
.vscode
.vercel
.cache
__pycache__/
*.py[cod]
.turbo
.codex-tmp-*
