# Local development template. Run `npm run env:setup` to create .env.local
# with generated secrets instead of copying this file by hand.

DIRECTUS_URL=http://127.0.0.1:8056
NEXT_PUBLIC_DIRECTUS_URL=http://127.0.0.1:8056
APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_TRUST_PROXY=false
REGISTRATION_ENABLED=true
PMC_WEBSITE_PUBLIC_URL=http://localhost:3001
# Optional public GA4 measurement ID. Leave empty to disable Google Analytics.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Optional Directus-only secret. Leave empty to disable Discord notifications.
DISCORD_ARTICLE_WEBHOOK_URL=
DIRECTUS_EMAIL_FROM=no-reply@pmc-website.local
MAILPIT_UI_PORT=8026

DIRECTUS_DEV_PORT=8056
DIRECTUS_DEV_SECRET=replace-with-at-least-32-random-characters
DIRECTUS_DEV_ADMIN_EMAIL=admin@example.com
DIRECTUS_DEV_ADMIN_PASSWORD=replace-with-a-random-password
DIRECTUS_DEV_MEMBER_EMAIL=member@example.com
DIRECTUS_DEV_MEMBER_PASSWORD=replace-with-a-random-password
DIRECTUS_DEV_DB_PASSWORD=replace-with-a-random-password

# Directus-wide fallback limits. Frontend authentication has stricter limits.
DIRECTUS_RATE_LIMITER_POINTS=1000
DIRECTUS_RATE_LIMITER_DURATION=60
DIRECTUS_REGISTRATION_RATE_LIMIT_POINTS=5
DIRECTUS_REGISTRATION_RATE_LIMIT_DURATION=3600

# Set true to notify Discord when an existing published article revision is approved.
DISCORD_ARTICLE_WEBHOOK_NOTIFY_UPDATES=false

MAX_IMAGE_UPLOAD_BYTES=8388608
MAX_IMAGE_INPUT_PIXELS=40000000

# Directus Data Studio uploads. Large world files use resumable 8 MB chunks.
DIRECTUS_FILES_MAX_UPLOAD_SIZE=2gb
DIRECTUS_TUS_CHUNK_SIZE=8mb
