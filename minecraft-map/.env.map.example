MAP_ARCHIVE=
# バックアップを別フォルダーから直接読む場合
MAP_ARCHIVE_DIRECTORY=./input
# Ubuntuではgenerate-history.shが自動設定します
MAP_GENERATOR_UID=10001
MAP_GENERATOR_GID=10001
MAP_WORLD_NAME=world
MAP_WORLD_ID=world
MAP_WORLD_LABEL=Minecraft World
# 空欄の場合は実行日時から自動生成されます
MAP_SNAPSHOT_ID=
MAP_SNAPSHOT_LABEL=
MAP_SNAPSHOT_CREATED_AT=
MAP_PUBLIC_BASE_URL=/minecraft-map
MAP_OUTPUT_FORMAT=JAVA_1_21_4
MAP_RENDER_MAPS=flat,surface
MAP_RENDER_MODE=full
MAP_RENDER_RADIUS=512
MAP_RENDER_CENTER_X=0
MAP_RENDER_CENTER_Z=0
# 空欄の場合はDynmapの既定動作を使用します。2 vCPUなら2が目安です
MAP_RENDER_THREADS=
MAP_RENDER_TIMEOUT_SECONDS=43200
CHUNKER_HEAP=8G
PAPER_HEAP=6G
MAP_MEMORY_LIMIT=12g
